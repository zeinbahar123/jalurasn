// JalurASN — skema database
// Provider: PostgreSQL (Neon / Supabase / Vercel Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// STATUS PAKET / LANGGANAN
// =========================================================

enum SubscriptionPlan {
  FREE
  PREMIUM
}

// =========================================================
// STATUS PEMBELIAN
// =========================================================

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

// =========================================================
// AKUN (login email + kata sandi)
// =========================================================

model User {
  id           String   @id @default(cuid())
  name         String?
  /// Wajib & unik. Disimpan dalam huruf kecil semua.
  email        String   @unique
  /// Hasil scrypt: "scrypt:<salt>:<hash>". Kata sandi asli tidak pernah disimpan.
  passwordHash String
  image        String?
  createdAt    DateTime @default(now())

  // --- Status akses pengguna ---
  subscription SubscriptionPlan @default(FREE)

  // --- Pengaman percobaan masuk beruntun ---
  gagalMasuk     Int       @default(0)
  terkunciSampai DateTime?

  // --- Profil pejuang CPNS -------------------------------
  namaTampilan      String?
  targetInstansi    String?
  targetFormasi     String?
  targetProvinsi    String?
  pendidikan        String?
  bio               String? @db.Text
  tampilDiPeringkat Boolean @default(true)

  // --- Status mentor (sudah lolos CPNS/PPPK) -------------
  isMentor      Boolean @default(false)
  tahunLolos    Int?
  instansiLolos String?

  // --- Relasi --------------------------------------------
  attempts     Attempt[]
  comments     Comment[]
  commentVotes CommentVote[]
  stories      Story[]
  bookmarks    Bookmark[]
  purchases    Purchase[]

  @@index([targetInstansi])
  @@index([isMentor])
  @@index([subscription])
}

// =========================================================
// TRY OUT
// =========================================================

enum StatusAttempt {
  BERLANGSUNG
  SELESAI
  KADALUARSA
}

model Attempt {
  id      String @id @default(cuid())
  userId  String
  paketId String

  status      StatusAttempt @default(BERLANGSUNG)
  mulaiPada   DateTime      @default(now())
  batasPada   DateTime
  selesaiPada DateTime?
  durasiDetik Int           @default(0)

  // Hasil (diisi saat submit)
  skorTWK   Int @default(0)
  skorTIU   Int @default(0)
  skorTKP   Int @default(0)
  skorTotal Int @default(0)

  benarTWK Int @default(0)
  benarTIU Int @default(0)

  lulusTWK   Boolean @default(false)
  lulusTIU   Boolean @default(false)
  lulusTKP   Boolean @default(false)
  lulusSemua Boolean @default(false)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers AttemptAnswer[]

  @@index([userId, paketId])
  @@index([paketId, skorTotal])
  @@index([status])
}

// =========================================================
// JAWABAN TRY OUT
// =========================================================

model AttemptAnswer {
  id           String  @id @default(cuid())
  attemptId    String
  soalId       String
  nomor        Int
  kategori     String
  jawaban      String?
  benar        Boolean @default(false)
  poin         Int     @default(0)
  raguRagu     Boolean @default(false)
  detikDipakai Int     @default(0)

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, soalId])
  @@index([attemptId])
}

// =========================================================
// PEMBELIAN TACTIX PREMIUM
// 1 pembelian Premium membuka Try Out 2–10
// =========================================================

model Purchase {
  id     String           @id @default(cuid())
  userId String
  plan   SubscriptionPlan @default(PREMIUM)
  amount Int
  status PurchaseStatus   @default(PENDING)

  // ID/reference dari payment gateway
  paymentReference String? @unique

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
}

// =========================================================
// KOMUNITAS
// =========================================================

// Diskusi menempel pada satu soal.
// Tiap soal punya "ruang kelas" sendiri.
model Comment {
  id        String   @id @default(cuid())
  soalId    String
  paketId   String
  userId    String
  isi       String   @db.Text
  parentId  String?
  dihapus   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("Balasan", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("Balasan")
  votes   CommentVote[]

  @@index([soalId, createdAt])
  @@index([userId])
}

// =========================================================
// VOTE KOMENTAR
// =========================================================

model CommentVote {
  id        String @id @default(cuid())
  commentId String
  userId    String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

// =========================================================
// CERITA PERJUANGAN
// =========================================================

// Termasuk cerita GAGAL, bukan hanya yang lolos.
model Story {
  id         String   @id @default(cuid())
  userId     String
  judul      String
  isi        String   @db.Text
  tahunUjian Int?
  instansi   String?
  hasilnya   String?
  tayang     Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tayang, createdAt])
}

// =========================================================
// BOOKMARK SOAL
// =========================================================

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  soalId    String
  paketId   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, soalId])
}
