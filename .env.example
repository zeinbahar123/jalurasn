# =========================================================
# JalurASN — contoh konfigurasi environment
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit file `.env` ke GitHub.
#
# Login memakai email + kata sandi, jadi TIDAK ada kredensial
# pihak ketiga yang perlu didaftarkan. Hanya dua nilai di bawah ini.
# =========================================================

# --- Database (PostgreSQL) -------------------------------
# Gratis: https://neon.tech  atau  https://supabase.com
# Contoh Neon:
# postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Kunci penandatangan sesi ----------------------------
# Buat secret acak:  npx auth secret     (atau: openssl rand -base64 32)
# Kalau nilai ini diganti, semua pengguna akan otomatis keluar.
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# --- URL publik aplikasi (opsional) ----------------------
# Lokal: http://localhost:3000
# Produksi: Vercel mengisinya otomatis, boleh dikosongkan.
NEXTAUTH_URL="http://localhost:3000"

# --- Alamat situs untuk SEO (opsional) -------------------
# Dipakai untuk canonical URL, sitemap.xml, dan gambar pratinjau tautan.
# Di Vercel akan terisi otomatis, JADI BOLEH DIKOSONGKAN.
# Isi manual hanya bila Anda memakai domain sendiri:
# NEXT_PUBLIC_SITE_URL="https://jalurasn.id"
